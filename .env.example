# LOCAL DEVELOPMENT ONLY. Run node scripts/setup.cjs. Never commit .env.
POSTGRES_USER=campusloop
POSTGRES_DB=campusloop
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_DATABASE_PASSWORD
DATABASE_URL=postgresql://campusloop:CHANGE_ME_LOCAL_DATABASE_PASSWORD@localhost:5432/campusloop?schema=public
APP_ORIGIN=http://localhost:3000
API_PORT=4000
API_HOST=127.0.0.1
API_INTERNAL_URL=http://127.0.0.1:4000
DEMO_MODE=true
DEMO_SEED=true
TRUST_PROXY_HOPS=0
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
MAIL_FROM=CampusLoop <no-reply@campusloop.example>
# Live SMTP only: SMTP_USER / SMTP_PASSWORD. Use TLS and an approved campus domain.

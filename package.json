{
  "name": "campusloop",
  "version": "1.0.0",
  "private": true,
  "description": "Schedule-aware college carpooling with accountable ride coordination.",
  "workspaces": [
    "packages/core",
    "apps/api",
    "apps/web"
  ],
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "build:core": "tsc -p packages/core/tsconfig.json",
    "build:api": "npm run build -w @campusloop/api",
    "build:web": "npm run build -w @campusloop/web",
    "build": "npm run build:core && npm run build:api && npm run build:web",
    "dev:api": "npm run dev -w @campusloop/api",
    "dev:web": "npm run dev -w @campusloop/web",
    "preview": "node demo/server.cjs",
    "test:offline": "node --test tests/*.test.cjs",
    "test": "npm run build:core && node scripts/sync-demo.cjs && npm run test:offline",
    "typecheck": "npm run build:core && npm run typecheck -w @campusloop/api && npm run typecheck -w @campusloop/web",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:migrate": "prisma migrate deploy --schema prisma/schema.prisma",
    "db:seed": "node scripts/seed.cjs",
    "test:postgres": "npm run build:api && node --test tests/integration/postgres.test.cjs",
    "test:e2e": "playwright test",
    "sync:demo": "node scripts/sync-demo.cjs"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "^22.15.0",
    "prisma": "6.19.3",
    "@playwright/test": "^1.56.0"
  },
  "license": "MIT"
}

FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY . .
ARG API_INTERNAL_URL=http://api:4000
ENV API_INTERNAL_URL=$API_INTERNAL_URL
ENV NEXT_TELEMETRY_DISABLED=1
RUN npm install && npm run build:core && npm run build:web && npm prune --omit=dev
USER node
EXPOSE 3000
CMD ["npm","run","start","-w","@campusloop/web"]
